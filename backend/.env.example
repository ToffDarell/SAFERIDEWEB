# Django Secret Key
SECRET_KEY=your-secret-key-here

# Database Configuration
DB_NAME=saferide_db
DB_USER=saferide_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# Google OAuth (Backend Secret - DO NOT SHARE)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# reCAPTCHA Keys
RECAPTCHA_PUBLIC_KEY=your-recaptcha-public-key
RECAPTCHA_PRIVATE_KEY=your-recaptcha-private-key
RECAPTCHA_VERIFY_ENABLED=True

# Debug Mode
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Production Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
USE_X_FORWARDED_PROTO=False

# Login Security
AUTH_LOCKOUT_FAILURE_LIMIT=5
AUTH_LOCKOUT_WINDOW_SECONDS=900
AUTH_LOCKOUT_DURATION_SECONDS=900
LOGIN_BURST_RATE=10/minute
LOGIN_SUSTAINED_RATE=30/hour
